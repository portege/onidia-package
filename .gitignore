# This workspace holds independent projects, each with its own repository.
# Only the SHARED build/release layer lives in this top-level repo:
#   Makefile, packaging/, agents/, docs/, and the release notes.
# The apps themselves are nested repos and must never be nested here.
/onidia/
/onidia-chat/
/web/
/registry/

# Build output (the Makefile writes packages here).
/dist/

# Large binaries, downloaded wheels and loose dev screenshots - not sources.
*.mkv
*.whl
/chat_ui_*.png

# OS / editor cruft
.DS_Store
*~

# Compiled Python (agents are plain .py; ship sources, not bytecode)
__pycache__/
*.pyc
